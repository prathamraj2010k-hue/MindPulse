# ============================================================
# MindPulse Backend Environment Variables
# Copy this file to ".env" and fill in your values
# ============================================================

# ----- MongoDB Connection -----
# Local MongoDB: mongodb://localhost:27017/mindpulse
# MongoDB Atlas (free cloud): mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mindpulse
MONGODB_URI=mongodb+srv://prathamraj2010k_db_user:9IEYsnTKAXqjNH2f@cluster0.o0zfis9.mongodb.net/?compressors=zlib

# ----- Server Port -----
PORT=3000

# ----- Google Gemini API Key (recommended, free) -----
# Get one at: https://aistudio.google.com  (click "Get API key")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ----- OR: OpenAI-compatible API (Groq, OpenAI, etc.) -----
# Uncomment these if you prefer OpenAI-compatible providers
# OPENAI_API_KEY=
# OPENAI_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# OPENAI_MODEL=llama-3.1-8b-instant

# ----- CORS (optional) -----
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*
